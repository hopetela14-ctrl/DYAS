<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Shop Name | DIY Mechanic Bay Rentals</title>
    <style>
        /* GLOBAL STYLING & FONT SETUP */
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9; /* Light background for clean look */
            color: #333;
        }
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px 0;
        }
        .btn {
            display: inline-block;
            padding: 12px 30px;
            background-color: #c82c2c; /* A strong, reliable red/maroon */
            color: white;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color 0.3s;
            border: none;
            cursor: pointer;
        }
        .btn:hover {
            background-color: #a82020;
        }

        /* HEADER & NAVIGATION */
        header {
            background-color: #2c3e50; /* Dark Navy/Charcoal for professionalism */
            color: white;
            padding: 15px 0;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-size: 28px;
            font-weight: bold;
            color: #f39c12; /* Accent color (Yellow/Orange) */
        }
        nav a {
            color: white;
            margin-left: 20px;
            text-decoration: none;
            font-weight: 500;
        }

        /* HERO SECTION */
        #hero {
            background-color: #eef2f7;
            padding: 80px 0;
            text-align: center;
        }
        #hero h1 {
            font-size: 3.5em;
            margin-bottom: 15px;
        }
        #hero p {
            font-size: 1.3em;
            margin-bottom: 30px;
        }

        /* SECTION STYLING (General) */
        section {
            padding: 60px 0;
            text-align: center;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* SERVICES SECTION (3 Columns) */
        #services .service-grid {
            display: flex;
            justify-content: space-around;
            gap: 20px;
            margin-top: 40px;
        }
        .service-card {
            flex: 1;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
            transition: transform 0.3s;
        }
        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }
        .service-card h3 {
            color: #333;
        }

        /* CTA SECTION */
        #cta {
            background-color: #34495e;
            color: white;
            padding: 50px 0;
        }
        #cta h2 {
            font-size: 2.5em;
            margin-bottom: 20px;
        }

        /* FOOTER */
        footer {
            background-color: #2c3e50;
            color: #aaa;
            padding: 20px 0;
            text-align: center;
        }
    </style>
</head>
<body>

    <!-- 1. NAVIGATION -->
    <header>
        <div class="container">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div class="logo">MECHANIC'S HUB</div>
                <nav>
                    <a href="#services">Services</a>
                    <a href="#about">About Us</a>
                    <a href="#contact">Contact</a>
                </nav>
            </div>
        </div>
    </header>

    <!-- 2. HERO SECTION -->
    <section id="hero">
        <div class="container">
            <h1>Your Trusted Pit Stop for All Automotive Needs</h1>
            <p>Expert maintenance, reliable repairs, and transparent pricing for every make and model.</p>
            <a href="#contact" style="background-color: #e74c3c; color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; font-size: 1.1em;">Book Your Service Today</a>
        </div>
    </section>

    <!-- 3. SERVICES SECTION -->
    <section id="services">
        <div class="container">
            <h2>What We Offer</h2>
            <p class="subtitle" style="margin-bottom: 40px;">From oil changes to engine overhauls, we cover it all.</p>
            <div class="service-grid">
                <div class="service-card">
                    <h3>Routine Maintenance</h3>
                    <p>Oil changes, tire rotations, fluid flushes, and general tune-ups to keep you running smoothly.</p>
                </div>
                <div class="service-card">
                    <h3>Engine Diagnostics</h3>
                    <p>Advanced computer diagnostics to pinpoint issues quickly and efficiently, saving you time and money.</p>
                </div>
                <div class="service-card">
                    <h3>Brake Services</h3>
                    <p>Inspection and replacement of pads, rotors, and calipers for maximum stopping power and safety.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. ABOUT US / TRUST SECTION -->
    <section id="about" style="background-color: #f9f9f9;">
        <div class="container">
            <h2>Why Choose Mechanic's Hub?</h2>
            <p style="max-width: 800px; margin: 20px auto 40px auto;">We combine years of expertise with modern technology. Our commitment is simple: transparency, quality, and getting you back on the road safely.</p>
            <div class="service-grid" style="max-width: 900px;">
                <div class="service-card" style="border-color: #2ecc71;">
                    <h3>✅ Certified Technicians</h3>
                    <p>Our team is highly trained and certified across multiple automotive brands.</p>
                </div>
                <div class="service-card" style="border-color: #3498db;">
                    <h3>🕒 Transparent Pricing</h3>
                    <p>No surprise fees. We provide detailed estimates before any work begins.</p>
                </div>
                <div class="service-card" style="border-color: #e67e22;">
                    <h3>⭐ Customer Satisfaction</h3>
                    <p>Your satisfaction is our priority. We stand by our work, guaranteed.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. CALL TO ACTION / CONTACT -->
    <section id="contact">
        <div class="container">
            <h2>Ready to Get Back on the Road?</h2>
            <p>Call us today or book your appointment online. We look forward to serving you!</p>
            <div style="margin-top: 30px;">
                <a href="tel:555-123-4567" style="background-color: #2ecc71; color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; font-size: 1.2em; margin-right: 20px;">Call Us</a>
                <a href="#" style="background-color: #3498db; color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; font-size: 1.2em;">Book Online</a>
            </div>
        </div>
    </section>

    <!-- 6. FOOTER -->
    <footer>
        <p>&copy; 2024 Mechanic's Hub. All rights reserved. | Privacy Policy</p>
    </footer>

</body>
</html>
