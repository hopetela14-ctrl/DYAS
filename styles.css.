/* 🎨 1. GLOBAL STYLES (Applies to the entire page body) */
body {
    font-family: Arial, sans-serif; /* Sets a default font */
    margin: 0; /* Removes default browser margins */
    background-color: #f4f4f9; /* A very light gray background */
    color: #333; /* Sets the default text color to dark gray */
}

/* 🖼️ 2. HEADER STYLING */
.main-header {
    background-color: #333; /* Dark background for the header */
    color: white;
    padding: 20px;
    text-align: center; /* Centers all content inside the header */
}

.main-header h1 {
    margin-top: 0;
}

/* Styling the navigation links */
.main-header nav a {
    color: white;
    text-decoration: none; /* Removes the default underline from links */
    margin: 0 15px;
    font-weight: bold;
}

/* 🧱 3. MAIN CONTENT AREA STYLING */
.container {
    padding: 40px;
    max-width: 900px; /* Limits how wide the content can get */
    margin: 30px auto; /* Centers the whole content box */
    background-color: white;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Adds a soft shadow effect */
    border-radius: 8px; /* Rounds the corners */
}

/* 🔘 4. BUTTON STYLING */
.cta-button {
    background-color: #007bff; /* A nice blue color */
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer; /* Changes the mouse pointer to a hand when hovering */
    transition: background-color 0.3s; /* Makes the color change smooth */
}

/* Hover effect: What happens when the mouse is over the button */
.cta-button:hover {
    background-color: #0056b3; /* Darker blue on hover */
}

/* 🦶 5. FOOTER STYLING */
footer {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 15px;
    position: fixed; /* Keeps the footer stuck to the bottom */
    bottom: 0;
    width: 100%;
}
